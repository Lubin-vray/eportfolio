<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="google-site-verification" content="Bo8OXhIcZvgD-ogY6iPfrYBiM1vLO_FOJ07yfogVYMA" />
		<title>
			{% block title %}Eportfolio
			{% endblock %}
		</title>
		<link id="theme" rel="stylesheet" href="{{ asset('css/style.css')}}">
		<link rel="icon" type="image/png" href="{{ asset('image/profile.png') }}">

		</head>
		<body>
			<nav class="navbar navbar-expand-lg navbar-light bg-light" id="mainNavbar" data-bs-theme="light">
				<div class="container-fluid">
					<a class="navbar-brand" href="/">Eportfolio</a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="navbarColor01">
						<ul class="navbar-nav me-auto">
							<li class="nav-item">
								<a class="nav-link {% if app.request.pathinfo == '/' %}active{% endif %}" href="/">Menu</a>
							</li>
							<li class="nav-item">
								<a class="nav-link {% if app.request.pathinfo == '/loisirs' %}active{% endif %}" href="/loisirs">Loisirs et Activités</a>
							</li>
							<li class="nav-item">
								<a class="nav-link {% if app.request.pathinfo == '/competences' or app.request.pathinfo == '/competences/sae1'or app.request.pathinfo == '/competences/sae2'or app.request.pathinfo == '/competences/sae3'or app.request.pathinfo == '/competences/sae4'or app.request.pathinfo == '/competences/sae5'or app.request.pathinfo == '/competences/saeportfolio' %}active{% endif %}" href="/competences">Compétences</a>
							</li>
							<li class="nav-item">
								<a class="nav-link {% if app.request.pathinfo == '/contact' %}active{% endif %}" href="/contact">Contact</a>
							</li>
							<li class="nav-item">
								<a class="nav-link {% if app.request.pathinfo == '/page-CV' or app.request.pathinfo == '/cv' %}active{% endif %}" href="/page-CV">CV</a>
							</li>
						</ul>
						<form class="d-flex align-items-center">
							<label class="theme-switch">
								<input type="checkbox" id="switch">
								<span class="slider"></span>
							</label>
						</form>
					</div>
				</div>
			</nav>
			{% block body %}{% endblock %}
			<footer class="mt-auto">
				<div class="container">
					<div class="row">
						<div class="col-md-4 mb-3">
							<h5>A propos de moi</h5>
							<p>18 ans</p>
							<p>Étudiant en informatique à l’IUT de Roanne</p>
							<p>Passioné d'informatique</p>
						</div>
						<div class="col-md-4 mb-3">
							<h5>Quelques liens</h5>
							<ul class="list-unstyled">
								<small>&copy; 2025 MonSite. Tous droits réservés.</small><br>
								<small>Adresse : 1 LIEU DIT EYVANT, 63660 Saint-anthème, France</small><br>
								<small>Email : lubin.vray@etu.univ-st-etienne.fr</small><br>
								<small>Téléphone : 07 67 74 84 27</small>
							</ul>
						</div>
						<div class="col-md-4 mb-3">
							<h5>Me suivre</h5>
							<ul class="list-inline social-icons">
								<li class="list-inline-item">
									<a href="https://github.com/Lubin-vray" class="text-white">
										<i class=""></i><img class="icon_footer" src="{{ asset('image/github.png')}}"></a>
								</li>
								
								<li class="list-inline-item">
									<a href="https://www.linkedin.com/in/lubin-vray/" class="text-white">
										<i class=""><img class="icon_footer" src="{{ asset('image/linkedin.png')}}"></i>
									</a>
								</li>
							</ul>
						</div>
					</div>
					<hr class="mb-4">
					<div class="row">
						<div class="col-md-12 text-center">
							<p>&copy; 2025 Your Company. All rights reserved.</p>
						</div>
					</div>
				</div>
			</footer>

			 <script>
			    const themeSwitch = document.getElementById("switch");
			    const navbar = document.getElementById("mainNavbar");
			
			    function applyTheme(theme) {
			        // Applique le thème sur tout le site
			        document.documentElement.setAttribute("data-bs-theme", theme);
			
			        // Applique aussi le thème directement sur la navbar
			        navbar.setAttribute("data-bs-theme", theme);
			
			        if (theme === "dark") {
			            navbar.classList.remove("navbar-light", "bg-light");
			            navbar.classList.add("navbar-dark", "bg-dark");
			            themeSwitch.checked = true;
			        } else {
			            navbar.classList.remove("navbar-dark", "bg-dark");
			            navbar.classList.add("navbar-light", "bg-light");
			            themeSwitch.checked = false;
			        }
			    }
			
			    themeSwitch.addEventListener("change", () => {
			        const current = document.documentElement.getAttribute("data-bs-theme");
			        const newTheme = current === "light" ? "dark" : "light";
			        applyTheme(newTheme);
			        localStorage.setItem("theme", newTheme);
			    });
			
			    // Restaure le thème enregistré
			    const savedTheme = localStorage.getItem("theme") || "dark"; // Défaut sur le thème sombre si aucun thème n'est enregistré
			    applyTheme(savedTheme);
			    </script>

		 <script src="https://cdn.j  sdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
			 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

		</body>
	</html>
